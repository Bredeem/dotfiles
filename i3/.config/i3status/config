# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
        colors = true
        interval = 5
}

order += "disk /"
order += "volume master"
order += "wireless _first_"
order += "battery all"
order += "load"
order += "tztime local"

wireless _first_ {
        format_up = "   %essid"
        format_down = "   down"
}

volume master {
        format = "   %volume"
        format_muted = "  (%volume)"
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}

battery all {
        format = "%status %percentage %remaining"
        status_bat = "   "
        status_chr = "   "
        status_full = "   "
        low_threshold = 20
        threshold_type = percentage
        integer_battery_capacity = true
        color_good = "#0000FF"
}

tztime local {
        format = "  %d.%m.%Y %H:%M:%S"
}

load {
        format = "  %1min"
}

disk "/" {
        format = "  %avail"
}
