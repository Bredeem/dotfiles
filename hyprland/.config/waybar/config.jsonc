{
  "layer": "top",
  "position": "top",
  "height": 40,
  "output": "eDP-1",
  "reload_style_on_change": true,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "bluetooth",
    "battery",
    "clock",
    "tray"
  ],
  "custom/separator": {
    "format": "|"
  },
  "hyprland/workspaces": {
    "on-click": "activate",
    "all-outputs": true,
    "format": "{name}: {icon}",
    "format-icons": {
      "urgent": "",
      "focused": "",
      "default": ""
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
    }
  },
  "tray": {
    "icon-size": 15,
    "spacing": 10
  },
  "clock": {
    "format-alt": "{:%A %d, %H:%M}",
    "format": "{:%H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 2,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#e06c75'><b>{}</b></span>",
        "days": "<span color='#abb2bf'><b>{}</b></span>",
        "weekdays": "<span color='#98c379'><b>{}</b></span>",
        "today": "<span color='#e5c07b'><b><u>{}</u></b></span>",
        "weeks": "{:%W}"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "bluetooth": {
    "format": " ",
    "format-disabled": " ",
    "format-connected": " ",
    "tooltip-format": "{status}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "blueman-manager",
    "on-click-right": "bluetoothctl power on"
  },
  "battery": {
    "states": {
      "warning": 18,
      "critical": 5
    },
    "format": "{capacity}%",
    "format-charging": "{capacity}%",
    "format-plugged": "{capacity}%",
    "format-alt": "{power}W",
    "format-icons": [
      " ",
      " ",
      " ",
      " ",
      " "
    ],
    "tooltip-format": "{power}W - {capacity}%"
  },
  "network": {
    "tooltip-format": "{ipaddr} - {signalStrength}%",
    "format": " ",
    "format-wifi": " ",
    "format-disconnected": " ",
    "format-ethernet": " "
  },
}
