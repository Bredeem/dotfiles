[user]
  email = brede@murberg.no
  name = Brede Eder Murberg

[init]
	defaultBranch = main

[core]
  editor = nvim

[color]
  ui = auto

[url "git@github.com:"]
  insteadOf = "gh:"
[filter "lfs"]
	smudge = git-lfs smudge --skip -- %f
	process = git-lfs filter-process --skip
	required = true
	clean = git-lfs clean -- %f
